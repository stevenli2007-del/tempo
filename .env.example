# Supabase 配置
#
# 本地开发：复制本文件为 .env.local 并填入真实值
#   cp .env.example .env.local
#
# Vercel 部署：在 Project Settings → Environment Variables 里配置同样的变量
#
# 注意：NEXT_PUBLIC_ 前缀的变量会被打包进前端，这是设计如此。
# anon key 本身可以公开，安全性由数据库 RLS 策略保证（见 Security-Privacy.md）。
# ⚠️ 绝不要把 service_role key 加到这里，也不要给它 NEXT_PUBLIC_ 前缀。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM 配置（P0-1-3）
#
# 切换 provider 只改 LLM_PROVIDER（deepseek | claude），不改业务代码（ADR-003）。
# ⚠️ LLM key 是密钥：绝不能加 NEXT_PUBLIC_ 前缀，否则会打进前端产物。
# ⚠️ Vercel 上新增/修改环境变量后，必须手动 Redeploy 才会注入到已完成的 build。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：不填即用各 provider 的默认模型（deepseek → deepseek-chat）
# LLM_MODEL=deepseek-chat
# 可选：单次请求超时上限（毫秒），默认 120000
# LLM_TIMEOUT_MS=120000

# Canvas 凭证加密（P0-2-2）
#
# 用于 AES-256-GCM 加密用户的 Canvas Personal Access Token（Security-Privacy.md 第 4 节）。
# ⚠️ 密钥：绝不能加 NEXT_PUBLIC_ 前缀，否则会打进前端产物。
# ⚠️ 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 轮换不是改个变量就完事 —— 要先用旧密钥解密全部凭证、再用新密钥重新加密。
CANVAS_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# 定时同步（P0-2-6 第二拍，T3 平台定时兜底）
#
# 🔴🔴 SUPABASE_SERVICE_ROLE_KEY 会绕过全部 RLS 策略，等于整库的万能钥匙：
#   - 绝不能加 NEXT_PUBLIC_ 前缀（加了就打进前端产物，等于把库交给所有人）
#   - 只有 /api/v1/sync/scheduled 用它遍历全部用户凭据，别处一律用用户级客户端
#   - 取值：Supabase Dashboard → Project Settings → API Keys → service_role
# 本地不配也能正常开发（只有定时端点会 500，其余功能不受影响）。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON_SECRET：定时端点的调度凭证。
#   - Vercel Cron 会自动带上 Authorization: Bearer ${CRON_SECRET}（用同名变量即可）
#   - 外部调度器（T4，如 cron-job.org）需要手动带这个头
#   - 没配这个变量时定时端点一律 500 拒绝执行，不会退化成公开端点
#   - 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret

# 邮件入站（P0-3-11，ADR-019：纯入站 + 密址绑定）
#
# INBOUND_EMAIL_SECRET：Cloudflare Worker ↔ Vercel 路由之间的共享密钥，
#   与 CRON_SECRET 同款恒定时间 + fail closed 鉴权。生成方式同上。
#   ⚠️ 绝不能加 NEXT_PUBLIC_ 前缀。
# INBOUND_EMAIL_DOMAIN：收件域名（不含协议/子域前缀），如 tempo.app。
#   用户的入站地址形如 inbound+<token>@<此域>。
INBOUND_EMAIL_SECRET=your-inbound-email-secret
INBOUND_EMAIL_DOMAIN=tempo.app

# 视觉 LLM（P0-3-9，ADR-018：按能力分 provider）
#
# 截图识别课程更新走 Qwen-VL（阿里云 DashScope），文本仍走 DeepSeek ——
# 两者是相互独立的 key。不配 DASHSCOPE_API_KEY 时截图识别端点会明确报
# 「截图识别暂不可用」，文本解析不受影响。
# 可选：LLM_PROVIDER_VISION（默认 qwen，可切 claude）、LLM_MODEL_VISION
# （默认 qwen-vl-plus-latest）。
# ⚠️ DASHSCOPE_API_KEY 是密钥：绝不能加 NEXT_PUBLIC_ 前缀。
DASHSCOPE_API_KEY=your-dashscope-api-key

# 邮件出站（P0-3-14 主动提醒）
#
# OUTBOUND_EMAIL_WORKER_URL：Cloudflare Worker 的出站发送端点（部署 Worker 后
#   由 Cloudflare 给出）。OUTBOUND_EMAIL_SECRET：Worker ↔ Vercel 之间的共享
#   Bearer 密钥，生成方式同 CRON_SECRET。
# ⚠️ 两者都是密钥/端点：绝不能加 NEXT_PUBLIC_ 前缀。
# ⚠️ 任一缺失时提醒引擎按「未启用出站」静默跳过（not_configured，不报错）
#   —— 即不配 = 提醒邮件永远发不出去且无报错，排障时先想到这里。
OUTBOUND_EMAIL_WORKER_URL=https://your-worker.your-subdomain.workers.dev
OUTBOUND_EMAIL_SECRET=your-outbound-email-secret

# 应用基础 URL（可选，P0-3-14 退订链接用）
#
# 拼进提醒邮件的退订链接。不配即用生产域名（tempo-six-neon.vercel.app），
# 本地预览出站邮件时才需要覆盖。非密钥，但也无需 NEXT_PUBLIC_ 前缀（仅服务端读）。
# APP_BASE_URL=https://tempo-six-neon.vercel.app
