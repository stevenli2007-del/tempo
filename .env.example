# Supabase 配置
#
# 本地开发：复制本文件为 .env.local 并填入真实值
#   cp .env.example .env.local
#
# Vercel 部署：在 Project Settings → Environment Variables 里配置同样的变量
#
# 注意：NEXT_PUBLIC_ 前缀的变量会被打包进前端，这是设计如此。
# anon key 本身可以公开，安全性由数据库 RLS 策略保证（见 Security-Privacy.md）。
# ⚠️ 绝不要把 service_role key 加到这里，也不要给它 NEXT_PUBLIC_ 前缀。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM 配置（P0-1-3）
#
# 切换 provider 只改 LLM_PROVIDER（deepseek | claude），不改业务代码（ADR-003）。
# ⚠️ LLM key 是密钥：绝不能加 NEXT_PUBLIC_ 前缀，否则会打进前端产物。
# ⚠️ Vercel 上新增/修改环境变量后，必须手动 Redeploy 才会注入到已完成的 build。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：不填即用各 provider 的默认模型（deepseek → deepseek-chat）
# LLM_MODEL=deepseek-chat
# 可选：单次请求超时上限（毫秒），默认 120000
# LLM_TIMEOUT_MS=120000

# Canvas 凭证加密（P0-2-2）
#
# 用于 AES-256-GCM 加密用户的 Canvas Personal Access Token（Security-Privacy.md 第 4 节）。
# ⚠️ 密钥：绝不能加 NEXT_PUBLIC_ 前缀，否则会打进前端产物。
# ⚠️ 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 轮换不是改个变量就完事 —— 要先用旧密钥解密全部凭证、再用新密钥重新加密。
CANVAS_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# 定时同步（P0-2-6 第二拍，T3 平台定时兜底）
#
# 🔴🔴 SUPABASE_SERVICE_ROLE_KEY 会绕过全部 RLS 策略，等于整库的万能钥匙：
#   - 绝不能加 NEXT_PUBLIC_ 前缀（加了就打进前端产物，等于把库交给所有人）
#   - 只有 /api/v1/sync/scheduled 用它遍历全部用户凭据，别处一律用用户级客户端
#   - 取值：Supabase Dashboard → Project Settings → API Keys → service_role
# 本地不配也能正常开发（只有定时端点会 500，其余功能不受影响）。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON_SECRET：定时端点的调度凭证。
#   - Vercel Cron 会自动带上 Authorization: Bearer ${CRON_SECRET}（用同名变量即可）
#   - 外部调度器（T4，如 cron-job.org）需要手动带这个头
#   - 没配这个变量时定时端点一律 500 拒绝执行，不会退化成公开端点
#   - 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
